{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "report.json, from the organisers' OUTPUT-CONTRACT.md.",
  "title": "Salvage report.json",
  "type": "object",
  "required": ["tool_version", "files", "totals"],
  "properties": {
    "tool_version": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "format", "status", "records", "damage"],
        "properties": {
          "file": {"type": "string"},
          "format": {"type": "string"},
          "status": {"enum": ["ok", "partial", "unsupported", "unrecognized", "failed"]},
          "records": {"type": "integer", "minimum": 0},
          "damage": {"type": "integer", "minimum": 0}
        }
      }
    },
    "totals": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "fatal": {"type": "string"}
  }
}
